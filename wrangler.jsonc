{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathaq-badia-menu",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mathaq-badia-menu",
      "database_id": "56030ade-a925-4919-a28f-417b15c651e0"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
